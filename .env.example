# Keep staging deployments out of search indexes.
# Do not set this to true on temporary hostingersite.com staging URLs.
PUBLIC_ALLOW_INDEXING=false

# Optional public GA4 Measurement ID (for example G-ABC123DEF4).
# Loaded only when PUBLIC_ALLOW_INDEXING=true and the value is a valid G- ID.
PUBLIC_GA4_MEASUREMENT_ID=
