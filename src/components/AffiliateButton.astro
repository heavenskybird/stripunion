---
import { AFFILIATE_REL, AVCAMS, STRIPCASH_SOURCE_ID } from '../config/site.js';
import { buildAvcamsUrl } from '../lib/affiliate.js';
import activeExperiments from '../../ops/growth/experiments/active.json';
import experimentRollouts from '../../ops/growth/experiments/rollouts.json';

const {
  source,
  label = 'Explore AVCams →',
  className = '',
  destinationPath = AVCAMS.defaultPath
} = Astro.props;

const tracking = buildAvcamsUrl({
  pagePath: Astro.url.pathname,
  placement: source,
  label,
  destinationPath
});

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const experiment = (activeExperiments?.experiments || []).find((item) =>
  item?.kind === 'avcams_cta_copy' &&
  (String(item.surface || '').replace(/\/$/, '') || '/') === normalizedPath
) || null;
const treatmentLabel = experiment?.variants?.treatment?.label || null;
const rollout = (experimentRollouts?.experiments || []).find((item) =>
  item?.kind === 'avcams_cta_copy' &&
  (String(item.surface || '').replace(/\/$/, '') || '/') === normalizedPath
) || null;
const rolloutLabel = rollout?.winner === 'treatment'
  ? rollout?.variants?.treatment?.label || null
  : null;
const effectiveLabel = rolloutLabel || label;
---
<span class="affiliate-cta">
  <a
    class:list={['button', 'button-primary', className]}
    href={tracking.url}
    target="_blank"
    rel={AFFILIATE_REL}
    data-affiliate-partner="avcams"
    data-affiliate-source={source}
    data-stripcash-campaign-id={tracking.campaignId}
    data-stripcash-creative-id={tracking.creativeId}
    data-stripcash-source-id={STRIPCASH_SOURCE_ID}
    data-stripcash-p1={tracking.pageKey}
    data-stripcash-p2={tracking.placement}
    data-avcams-target-domain={tracking.targetDomain}
    data-avcams-path={tracking.destinationPath}
    data-experiment-id={experiment?.experimentId || undefined}
    data-experiment-treatment-label={treatmentLabel || undefined}
  >
    {effectiveLabel}
  </a>
</span>
