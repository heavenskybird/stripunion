---
import { AFFILIATE_REL } from '../config/site.js';
import offersRegistry from '../../ops/growth/offers/direct-offers.json';

const { source, label = 'Explore BongaCams →', className = '' } = Astro.props;
const offer = (offersRegistry.offers || []).find((item) => item?.id === 'bongacams');
const approved = offer?.status === 'active' &&
  offer?.approval_status === 'approved_active' &&
  typeof offer?.viewer_campaign_url === 'string' &&
  offer.viewer_campaign_url.startsWith('https://bongacams4.com/track?c=');
---
{approved && (
  <span class="affiliate-cta">
    <a
      class:list={['button', 'button-secondary', className]}
      href={offer.viewer_campaign_url}
      target="_blank"
      rel={AFFILIATE_REL}
      data-affiliate-partner="bongacams"
      data-affiliate-source={source}
      data-affiliate-mode="bongacash-viewer"
    >
      {label}
    </a>
  </span>
)}
