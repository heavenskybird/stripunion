---
const { title = 'Alternatives to compare', items = [] } = Astro.props;
---
<section class="discovery-alternatives"><h2>{title}</h2><div class="discovery-card-grid">{items.map((item) => <article class="discovery-card"><h3>{item.name}</h3><p>{item.reason}</p>{item.href && <a class="text-link" href={item.href}>Compare details →</a>}</article>)}</div></section>
