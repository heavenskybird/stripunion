---
const { title = 'Compare options', columns = [], rows = [] } = Astro.props;
---
<section class="discovery-comparison"><h2>{title}</h2><div class="discovery-table-scroll"><table><thead><tr><th scope="col">Decision point</th>{columns.map((column) => <th scope="col">{column}</th>)}</tr></thead><tbody>{rows.map((row) => <tr><th scope="row">{row.label}</th>{row.values.map((value) => <td>{value}</td>)}</tr>)}</tbody></table></div></section>
