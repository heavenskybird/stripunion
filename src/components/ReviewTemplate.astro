---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from './AffiliateButton.astro';
import { SITE, updatedLabel } from '../config/site.js';
import DiscoveryHero from './discovery/DiscoveryHero.astro';
import PricingTable from './discovery/PricingTable.astro';
import ProsCons from './discovery/ProsCons.astro';

const { review } = Astro.props;
const firstCtaSource = `${review.slug}_top`;
const bottomCtaSource = `${review.slug}_bottom`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: review.category, item: new URL(`/${review.categorySlug}`, SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: review.name, item: new URL(`/${review.slug}`, SITE.url).toString() }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: review.faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
};
---
<BaseLayout
  title={review.title}
  description={review.description}
  pageType="Article"
  extraSchemas={[breadcrumbSchema, faqSchema]}
>
  <DiscoveryHero eyebrow="Independent review" title={review.title} description={review.dek} updated={updatedLabel} image={review.heroImage}>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href={`/${review.categorySlug}`}>{review.category}</a><span>/</span><span>{review.name}</span>
    </nav>
    {review.partner ? <AffiliateButton source={firstCtaSource} /> : <div class="alternative-cta"><AffiliateButton source={`${review.slug}_alternative_top`} /></div>}
  </DiscoveryHero>
  <section class="section shell narrow">
    <div class="decision-grid">
      <div><span>Best for</span><strong>{review.bestFor}</strong></div>
      <div><span>Access model</span><strong>{review.access}</strong></div>
      <div><span>Paid model</span><strong>{review.model}</strong></div>
    </div>

    <PricingTable title="Access and paid model" rows={[{ item: "Public access", price: review.access, checked: updatedLabel }, { item: "Paid model", price: review.model, checked: updatedLabel }]} note="Terms and prices can vary. Check current provider information before spending." />

    <div class="take-box">
      <span class="kicker">StripUnion's take</span>
      <p>{review.verdict}</p>
    </div>

    <ProsCons pros={review.strengths} cons={review.limitations} />

    <div class="article-body">
      {review.sections.map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}
    </div>

    <section class="conversion-strip">
      <div>
        <span class="kicker">Explore live on AVCams</span>
        <h2>Want to explore live models now?</h2>
        <p>{`After reading about ${review.name}, continue your comparison on AVCams and browse the current live rooms.`}</p>
      </div>
      <AffiliateButton source={review.partner ? `${review.slug}_mid` : `${review.slug}_alternative_mid`} />
    </section>

    {review.relatedLinks?.length > 0 && (
      <section class="related-guides">
        <span class="kicker">Continue your decision</span>
        <h2>Related StripUnion guides</h2>
        <div class="money-grid">
          {review.relatedLinks.map(([label, href]) => (
            <a class="money-card related-card" href={href}>
              <h3>{label}</h3>
              <span class="text-link">Read guide →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="faq">
      <span class="kicker">FAQ</span>
      <h2>Questions about {review.name}</h2>
      {review.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}
    </section>

    <section class="end-cta">
      <div>
        <span class="kicker">Explore now</span>
        <h2>Ready to explore AVCams?</h2>
        <p>Open AVCams if a live-cam experience matches what you want after this comparison.</p>
      </div>
      <AffiliateButton source={review.partner ? bottomCtaSource : `${review.slug}_alternative_bottom`} />
    </section>
  </section>
</BaseLayout>
