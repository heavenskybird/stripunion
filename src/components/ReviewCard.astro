---
import AffiliateButton from './AffiliateButton.astro';

const { review, source = 'review_card' } = Astro.props;
---
<article class="review-card">
  <div class="card-topline">
    <span class="kicker">{review.category}</span>
    {review.partner && <span class="partner-badge">Current partner</span>}
  </div>
  <h3><a href={`/${review.slug}`}>{review.name}</a></h3>
  <p>{review.dek}</p>
  {!review.partner && <p class="card-partner-note">No approved affiliate offer for {review.name}; Stripchat is our current partner alternative.</p>}
  <div class="card-actions">
    <a class="text-link" href={`/${review.slug}`}>Read review →</a>
    <AffiliateButton source={review.partner ? source : `${source}_alternative`} />
  </div>
</article>
