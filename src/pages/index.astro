---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { categories } from '../data/categories.js';
import { reviews } from '../data/reviews.js';
import { SITE } from '../config/site.js';

const featured = [reviews.stripchat, reviews.chaturbate, reviews.livejasmin, reviews.adultfriendfinder];
---
<BaseLayout
  title="Adult Platform Reviews & Comparisons"
  description="Compare adult entertainment platforms with independent reviews, pricing guides and side-by-side comparisons. Adults 18+ only."
>
  <section class="hero">
    <div class="shell hero-inner">
      <span class="kicker">Adult reviews · comparisons · adults 18+</span>
      <h1>Adult platform reviews without the guesswork.</h1>
      <p>StripUnion helps you compare how adult platforms actually work — access model, paid features, usability, privacy considerations and key trade-offs — before you leave our site.</p>
      <div class="hero-actions">
        <AffiliateButton source="homepage_hero" />
        <a class="button button-secondary" href="/stripchat-vs-chaturbate">Compare live cam options</a>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="blog-band">
      <div>
        <span class="kicker">Our live-cam destination</span>
        <h2>Research on StripUnion, then continue to AVCams.</h2>
        <p>StripUnion keeps comparisons and buying context editorial; AVCams is our branded StripCash white-label for the live-room experience when you are ready to leave the research layer.</p>
      </div>
      <a class="button button-secondary" href="/avcams">About AVCams →</a>
    </div>
  </section>

  <section class="section shell">
    <div class="section-head">
      <span class="kicker">Live-cam decision guides</span>
      <h2>High-intent pages built around the questions buyers actually search.</h2>
      <p>Use the comparison, pricing and alternatives pages to narrow the decision before taking the commercial next step.</p>
    </div>
    <div class="money-grid">
      <article class="money-card"><span class="kicker">Our live destination</span><h3>AVCams</h3><p>Explore StripUnion’s branded StripCash white-label after you finish comparing live-cam models.</p><a class="text-link" href="/avcams">Learn about AVCams →</a></article>
      <article class="money-card"><span class="kicker">Comparison</span><h3>Stripchat vs LiveJasmin</h3><p>Compare public-room discovery with a more premium/private-interaction-oriented model.</p><a class="text-link" href="/stripchat-vs-livejasmin">Compare →</a></article>
      <article class="money-card"><span class="kicker">Pricing intent</span><h3>Tokens & Live-Cam Pricing</h3><p>Use our Stripchat pricing research to understand the token model that also underlies the AVCams white-label experience.</p><a class="text-link" href="/stripchat-pricing">See pricing guide →</a></article>
      <article class="money-card"><span class="kicker">Alternatives</span><h3>Chaturbate Alternatives</h3><p>For users actively looking for another public-room option.</p><a class="text-link" href="/chaturbate-alternatives">See alternatives →</a></article>
      <article class="money-card"><span class="kicker">Search intent</span><h3>Stripchat Alternatives</h3><p>Use the Stripchat alternatives research as an acquisition guide, then continue to AVCams if the public-room model fits.</p><a class="text-link" href="/stripchat-alternatives">See alternatives →</a></article>
      <article class="money-card"><span class="kicker">Free-access intent</span><h3>Best Free Live Cam Sites</h3><p>Understand what “free” actually includes before optional paid interaction begins.</p><a class="text-link" href="/best-free-live-cam-sites">Read guide →</a></article>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head">
        <span class="kicker">Broader discovery</span>
      <h2>Explore categories</h2>
      <p>Different categories should be judged by different criteria. We separate live interaction, subscriptions, dating, games and retail instead of treating every adult platform the same way.</p>
    </div>
    <div class="category-grid">
      {categories.map((category) => (
        <a class="category-card" href={`/${category.slug}`}>
          <span class="kicker">{category.name}</span>
          <h3>{category.title.replace('Reviews & Comparison Guide','').replace('Reviews & Discovery Guide','')}</h3>
          <p>{category.description}</p>
          <span class="text-link">Explore category →</span>
        </a>
      ))}
    </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-head">
        <span class="kicker">Featured reviews</span>
        <h2>Begin with the platforms readers are most likely to compare.</h2>
        <p>Start with the reviews readers compare most, then jump into pricing, alternatives and live-room options.</p>
      </div>
      <div class="review-grid">
        {featured.map((review) => <ReviewCard review={review} source={`homepage_featured_${review.slug}`} />)}
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="blog-band">
      <div>
        <span class="kicker">High-intent comparison</span>
        <h2>Compare first; use AVCams as the live destination.</h2>
        <p>Stripchat-vs-Chaturbate remains a useful search and research question. When that public-room model fits, the tracked commercial route from StripUnion goes to AVCams.</p>
      </div>
      <div class="hero-actions">
        <a class="button button-secondary" href="/stripchat-vs-chaturbate">Read comparison →</a>
        <a class="button button-outline" href="/best-live-cam-sites">Best live cam sites →</a>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="trust-grid">
      <div>
        <span class="kicker">How we review</span>
        <h2>Useful decision factors, not invented scores.</h2>
      </div>
      <div class="trust-points">
        <div class="trust-point"><strong>Editorial independence</strong><span>We do not label a platform “best” simply because it has an affiliate relationship.</span></div>
                <div class="trust-point"><strong>Practical criteria</strong><span>We focus on access model, cost structure, usability, privacy information and category-specific trade-offs.</span></div>
        <div class="trust-point"><strong>No fabricated social proof</strong><span>No fake star ratings, testimonials, user counts or “tested by us” claims without evidence.</span></div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="blog-band">
      <div>
        <span class="kicker">Research before you spend</span>
        <h2>Use the live-cam guide hub for the questions that come before a platform choice.</h2>
        <p>Learn how public rooms, free browsing, mobile access, token systems and safety trade-offs work, then return to StripUnion's review and pricing pages when you are ready to decide.</p>
      </div>
      <div class="hero-actions">
        <a class="button button-secondary" href="https://blog.stripunion.com/guides/">Browse live-cam guides →</a>
        <a class="button button-outline" href="https://blog.stripunion.com/live-cam-site-safety/">Safety guide →</a>
      </div>
    </div>
  </section>
</BaseLayout>
