---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { categories } from '../data/categories.js';
import { reviews } from '../data/reviews.js';
import { SITE } from '../config/site.js';

const featured = [reviews.stripchat, reviews.chaturbate, reviews.livejasmin, reviews.adultfriendfinder];
---
<BaseLayout
  title="Adult Platform Reviews & Comparisons"
  description="Compare adult entertainment platforms with independent reviews, category guides and transparent affiliate disclosures. Adults 18+ only."
>
  <section class="hero">
    <div class="shell hero-inner">
      <span class="kicker">Independent reviews · clear disclosures · adults 18+</span>
      <h1>Adult platform reviews without the guesswork.</h1>
      <p>StripUnion helps you compare how adult platforms actually work — access model, paid features, usability, privacy considerations and key trade-offs — before you leave our site.</p>
      <div class="hero-actions">
        <AffiliateButton source="homepage_hero" />
        <a class="button button-secondary" href="/stripchat-vs-chaturbate">Compare live cam options</a>
      </div>
      <p class="micro">Commercial partner link. StripUnion may earn a commission from qualifying referrals, at no extra cost to you.</p>
    </div>
  </section>

  <section class="section shell">
    <div class="blog-band">
      <div>
        <span class="kicker">Fastest path to a decision</span>
        <h2>Compare Stripchat with Chaturbate, then choose your next step.</h2>
        <p>This high-intent comparison keeps the research on StripUnion and gives you one clearly tracked commercial option when you are ready.</p>
      </div>
      <a class="button button-secondary" href="/stripchat-vs-chaturbate">Compare now →</a>
    </div>
  </section>

  <section class="section shell">
    <div class="section-head">
      <span class="kicker">Broader discovery</span>
      <h2>Explore categories</h2>
      <p>Different categories should be judged by different criteria. We separate live interaction, subscriptions, dating, games and retail instead of treating every adult platform the same way.</p>
    </div>
    <div class="category-grid">
      {categories.map((category) => (
        <a class="category-card" href={`/${category.slug}`}>
          <span class="kicker">{category.name}</span>
          <h3>{category.title.replace('Reviews & Comparison Guide','').replace('Reviews & Discovery Guide','')}</h3>
          <p>{category.description}</p>
          <span class="text-link">Explore category →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-head">
        <span class="kicker">Featured reviews</span>
        <h2>Begin with the platforms readers are most likely to compare.</h2>
        <p>Editorial links take you to StripUnion reviews. Commercial partner buttons are shown separately and labeled clearly.</p>
      </div>
      <div class="review-grid">
        {featured.map((review) => <ReviewCard review={review} source={`homepage_featured_${review.slug}`} />)}
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="blog-band">
      <div>
        <span class="kicker">High-intent comparison</span>
        <h2>Stripchat vs Chaturbate</h2>
        <p>Compare public access, token-based spending, private interactions and discovery style without hiding the fact that only Stripchat is currently an affiliate partner.</p>
      </div>
      <div class="hero-actions">
        <a class="button button-secondary" href="/stripchat-vs-chaturbate">Read comparison →</a>
        <a class="button button-outline" href="/best-live-cam-sites">Best live cam sites →</a>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="trust-grid">
      <div>
        <span class="kicker">How we review</span>
        <h2>Useful decision factors, not invented scores.</h2>
      </div>
      <div class="trust-points">
        <div class="trust-point"><strong>Editorial independence</strong><span>We do not label a platform “best” simply because it has an affiliate relationship.</span></div>
        <div class="trust-point"><strong>Transparent monetization</strong><span>Affiliate buttons are visually and textually separated from editorial links.</span></div>
        <div class="trust-point"><strong>Practical criteria</strong><span>We focus on access model, cost structure, usability, privacy information and category-specific trade-offs.</span></div>
        <div class="trust-point"><strong>No fabricated social proof</strong><span>No fake star ratings, testimonials, user counts or “tested by us” claims without evidence.</span></div>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="blog-band">
      <div>
        <span class="kicker">StripUnion Blog</span>
        <h2>Comparisons and decision guides.</h2>
        <p>Our editorial blog covers side-by-side comparisons and broader guides. Main-site reviews provide the deeper platform pages those articles can link into.</p>
      </div>
      <a class="button button-secondary" href={SITE.blogUrl}>Visit the blog →</a>
    </div>
  </section>
</BaseLayout>
