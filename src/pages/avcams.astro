---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import LiveModelsGrid from '../components/LiveModelsGrid.astro';

const title = 'AVCams: Explore Live Cam Rooms';
const description = 'Explore AVCams live rooms, search by interest, browse public rooms and use optional token-based interactions. Adults 18+.';

const quickSearches = [
  { label: 'Cosplay', query: 'cosplay', source: 'avcams_search_cosplay' },
  { label: 'Gaming', query: 'gaming', source: 'avcams_search_gaming' },
  { label: 'Natural look', query: 'natural%20look', source: 'avcams_search_natural' },
  { label: 'Office style', query: 'office', source: 'avcams_search_office' }
];
---
<BaseLayout title={title} description={description} pageType="Article">
  <section class="page-hero">
    <div class="shell narrow">
      <nav class="breadcrumbs"><a href="/">Home</a><span>/</span><span>AVCams</span></nav>
      <span class="kicker">Live cams · Adults 18+</span>
      <h1>Explore live rooms on AVCams</h1>
      <p class="lead">Browse live rooms, discover models and decide how you want to interact. Public-room browsing comes first, with optional token-based features when you want more.</p>
      <div class="hero-actions">
        <AffiliateButton source="avcams_hero" label="Explore AVCams →" />
        <a class="button button-secondary" href="/best-live-cam-sites">Compare live-cam models first</a>
      </div>
    </div>
  </section>

  <section class="section shell narrow">
    <div class="decision-grid">
      <div><span>Discovery</span><strong>Public live rooms</strong><p>Browse the live experience before deciding whether to use optional paid interactions.</p></div>
      <div><span>Paid layer</span><strong>Token-based interaction</strong><p>Selected tips, private sessions and interactive features can use tokens.</p></div>
      <div><span>Experience</span><strong>Browse first</strong><p>Explore live rooms before deciding whether you want to use optional paid features.</p></div>
    </div>

    <div id="browse">
      <LiveModelsGrid />
    </div>

    <section class="related-guides">
      <span class="kicker">Find a room faster</span>
      <h2>Start with an interest</h2>
      <p>Jump straight into a live-room search, then choose from the models who are online now.</p>
      <div class="money-grid">
        {quickSearches.map((item) => (
          <article class="money-card">
            <h3>{item.label}</h3>
            <p>See live rooms matching this interest.</p>
            <AffiliateButton
              source={item.source}
              label={`Explore ${item.label} →`}
              destinationPath={`/search/magic-search/${item.query}`}
            />
          </article>
        ))}
      </div>
    </section>

    <section class="article-body">
      <section>
        <h2>Move from comparison to live discovery</h2>
        <p>After comparing platforms and features on StripUnion, AVCams gives you a direct way to browse live rooms and see what is available now.</p>
      </section>
      <section>
        <h2>Compare first, then explore</h2>
        <p>Use StripUnion’s reviews and comparisons to understand access models, tokens, discovery features and pricing. When you are ready to browse live rooms, continue to AVCams.</p>
      </section>
      <section>
        <h2>Want to broadcast rather than watch?</h2>
        <p>If you want to broadcast rather than watch, use the model signup route below. Viewer access and model registration are separate paths.</p>
        <div class="hero-actions">
          <a class="button button-secondary" href="/become-a-cam-model">Read the model signup guide →</a>
          <AffiliateButton source="avcams_model_signup" label="Become a Model →" destinationPath="/signup/model" />
        </div>
      </section>
    </section>

    <section class="conversion-strip">
      <div>
        <span class="kicker">Live now</span>
        <h2>Ready to browse AVCams?</h2>
        <p>Continue to the current live-room experience on AVCams. Exact room availability and paid options can change in real time.</p>
      </div>
      <AffiliateButton source="avcams_bottom" label="Explore AVCams →" />
    </section>

    <section class="related-guides">
      <span class="kicker">Research first</span>
      <h2>Useful StripUnion guides</h2>
      <div class="money-grid">
        <a class="money-card related-card" href="/best-live-cam-sites"><h3>Best Live Cam Sites</h3><span class="text-link">Compare platform models →</span></a>
        <a class="money-card related-card" href="/stripchat"><h3>Stripchat Review</h3><span class="text-link">Compare the public-room experience →</span></a>
        <a class="money-card related-card" href="/stripchat-pricing"><h3>Pricing & Tokens</h3><span class="text-link">Understand token spending →</span></a>
        <a class="money-card related-card" href="/stripchat-magic-search"><h3>Magic Search</h3><span class="text-link">Understand live-room discovery →</span></a>
      </div>
    </section>
  </section>
</BaseLayout>
