---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateButton from '../components/AffiliateButton.astro';

const title = 'AVCams: Live Cam Discovery on Our Branded White-Label';
const description = 'Explore AVCams, StripUnion’s branded live-cam destination powered by StripCash and the Stripchat infrastructure, with public-room discovery and optional paid interactions.';
---
<BaseLayout title={title} description={description} pageType="Article">
  <section class="page-hero">
    <div class="shell narrow">
      <nav class="breadcrumbs"><a href="/">Home</a><span>/</span><span>AVCams</span></nav>
      <span class="kicker">StripUnion’s branded live-cam destination · Adults 18+</span>
      <h1>Explore live rooms on AVCams</h1>
      <p class="lead">AVCams is StripUnion’s branded StripCash white-label. It uses Stripchat’s underlying live-cam infrastructure and model inventory while keeping the user experience on the AVCams brand and domain.</p>
      <div class="hero-actions">
        <AffiliateButton source="avcams_hero" label="Explore AVCams →" />
        <a class="button button-secondary" href="/best-live-cam-sites">Compare live-cam models first</a>
      </div>
    </div>
  </section>

  <section class="section shell narrow">
    <div class="decision-grid">
      <div><span>Discovery</span><strong>Public live rooms</strong><p>Browse the live experience before deciding whether to use optional paid interactions.</p></div>
      <div><span>Paid layer</span><strong>Token-based interaction</strong><p>Selected tips, private sessions and interactive features can use tokens.</p></div>
      <div><span>Brand relationship</span><strong>AVCams + StripCash</strong><p>AVCams is our branded white-label destination rather than an unrelated third-party platform.</p></div>
    </div>

    <section class="article-body">
      <section>
        <h2>Why StripUnion sends live-cam traffic to AVCams</h2>
        <p>StripUnion remains the independent research and comparison layer. When you decide to explore live rooms, AVCams is the branded destination we operate through the StripCash white-label program. This keeps the research experience and the commercial destination clearly separated.</p>
      </section>
      <section>
        <h2>Research third-party platforms without losing the next step</h2>
        <p>Pages about Stripchat, Chaturbate and other platforms remain useful when you are comparing access models, tokens, discovery features or pricing structures. Those editorial pages can still answer brand-specific searches, while the commercial live-cam route from StripUnion goes to AVCams.</p>
      </section>
      <section>
        <h2>Want to broadcast rather than watch?</h2>
        <p>AVCams also supports the StripCash model-referral flow. Model registration is a separate creator path from the viewer experience.</p>
        <AffiliateButton source="avcams_model_signup" label="Become a model on AVCams →" destinationPath="/signup/model" />
      </section>
    </section>

    <section class="conversion-strip">
      <div>
        <span class="kicker">Live now</span>
        <h2>Ready to browse AVCams?</h2>
        <p>Continue to the current live-room experience on AVCams. Exact room availability and paid options can change in real time.</p>
      </div>
      <AffiliateButton source="avcams_bottom" label="Explore AVCams →" />
    </section>

    <section class="related-guides">
      <span class="kicker">Research first</span>
      <h2>Useful StripUnion guides</h2>
      <div class="money-grid">
        <a class="money-card related-card" href="/best-live-cam-sites"><h3>Best Live Cam Sites</h3><span class="text-link">Compare platform models →</span></a>
        <a class="money-card related-card" href="/stripchat"><h3>Stripchat Review</h3><span class="text-link">Understand the underlying platform model →</span></a>
        <a class="money-card related-card" href="/stripchat-pricing"><h3>Pricing & Tokens</h3><span class="text-link">Understand token spending →</span></a>
        <a class="money-card related-card" href="/stripchat-magic-search"><h3>Magic Search</h3><span class="text-link">Understand live-room discovery →</span></a>
      </div>
    </section>
  </section>
</BaseLayout>
