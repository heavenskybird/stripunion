---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="18+ Notice" description="StripUnion is intended only for adults who meet the age of majority where they live.">
  <section class="page-hero"><div class="shell narrow"><span class="kicker">18+ only</span><h1>StripUnion is for adults only.</h1><p class="lead">Do not use this site if you are under 18 or below the age of majority required in your jurisdiction.</p></div></section>
  <section class="section shell narrow article-body">
    <h2>Local rules still apply</h2><p>Age requirements and restrictions can differ by location. You are responsible for following the laws and access requirements that apply where you live.</p>
    <h2>Third-party destinations</h2><p>Platforms linked from StripUnion may operate their own age gates and eligibility rules. Review those requirements before accessing or purchasing from a third-party service.</p>
  </section>
</BaseLayout>
