---
import '../styles/global.css';
import { SITE } from '../config/site.js';

const {
  title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  robots = SITE.allowIndexing ? 'index,follow' : 'noindex,nofollow',
  pageType = 'WebPage',
  extraSchemas = []
} = Astro.props;

const safeTitle = title || SITE.name;
const fullTitle = safeTitle.includes('StripUnion') ? safeTitle : `${safeTitle} | StripUnion`;
const canonicalUrl = new URL(canonical, SITE.url).toString();

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': pageType,
  name: safeTitle,
  description,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url
  }
};

const schemas = [organizationSchema, pageSchema, ...extraSchemas];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#120f18" />
    <meta name="robots" content={robots} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={pageType === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="StripUnion home">StripUnion</a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/best-live-cam-sites">Best Live Cams</a>
          <a href="/stripchat">Stripchat Review</a>
          <a href="/stripchat-vs-chaturbate">Compare</a>
          <a href="/stripchat-pricing">Pricing & Tokens</a>
          <a href="/chaturbate-alternatives">Alternatives</a>
          <a href={SITE.blogUrl}>Blog</a>
        </nav>
        <span class="age-pill">18+</span>
        <details class="mobile-menu">
          <summary aria-label="Open navigation">Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="/best-live-cam-sites">Best Live Cams</a>
            <a href="/stripchat">Stripchat Review</a>
            <a href="/stripchat-vs-chaturbate">Stripchat vs Chaturbate</a>
            <a href="/stripchat-vs-livejasmin">Stripchat vs LiveJasmin</a>
            <a href="/stripchat-pricing">Pricing & Tokens</a>
            <a href="/chaturbate-alternatives">Chaturbate Alternatives</a>
            <a href="/stripchat-alternatives">Stripchat Alternatives</a>
            <a href={SITE.blogUrl}>Blog</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href="/">StripUnion</a>
          <p>Independent adult-platform reviews, comparisons and discovery guides for adults 18+.</p>
          <p class="muted">StripUnion may earn commissions from qualifying referrals.</p>
        </div>
        <div>
          <h2>Money pages</h2>
          <a href="/best-live-cam-sites">Best Live Cams</a>
          <a href="/stripchat">Stripchat Review</a>
          <a href="/stripchat-pricing">Pricing & Tokens</a>
          <a href="/stripchat-vs-chaturbate">Stripchat vs Chaturbate</a>
          <a href="/stripchat-vs-livejasmin">Stripchat vs LiveJasmin</a>
          <a href="/chaturbate-alternatives">Chaturbate Alternatives</a>
          <a href={SITE.blogUrl}>Blog</a>
        </div>
        <div>
          <h2>Editorial</h2>
          <a href="/about">About</a>
          <a href="/editorial-policy">Editorial Policy</a>
          <a href="/affiliate-disclosure">Affiliate Disclosure</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Use</a>
          <a href="/age-verification">18+ Notice</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} StripUnion.</span>
        <span>Adults 18+ only. Follow the laws that apply where you live.</span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const sanitize = (value) =>
          String(value || 'unknown')
            .toLowerCase()
            .replace(/[^a-z0-9_-]+/g, '_')
            .replace(/^_+|_+$/g, '')
            .slice(0, 80) || 'unknown';

        const detectAcquisition = () => {
          const params = new URLSearchParams(window.location.search);
          const utmSource = params.get('utm_source');
          if (utmSource) return sanitize(`utm_${utmSource}`);

          if (!document.referrer) return 'direct';

          try {
            const ref = new URL(document.referrer);
            const host = ref.hostname.toLowerCase();

            if (host === 'blog.stripunion.com') return 'stripunion_blog';
            if (host === window.location.hostname) return 'internal';
            if (host.includes('google.')) return 'google';
            if (host.includes('bing.')) return 'bing';
            if (host.includes('duckduckgo.')) return 'duckduckgo';
            if (host.includes('yahoo.')) return 'yahoo';
            if (host.includes('yandex.')) return 'yandex';

            return sanitize(`ref_${host}`);
          } catch {
            return 'referral';
          }
        };

        let acquisition = 'unknown';
        try {
          acquisition =
            sessionStorage.getItem('su_acquisition') ||
            detectAcquisition();
          sessionStorage.setItem('su_acquisition', acquisition);
        } catch {
          acquisition = detectAcquisition();
        }

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('[data-affiliate-source]');
          if (!(link instanceof HTMLAnchorElement)) return;

          const outbound = new URL(link.href);
          const isStaging = window.location.hostname.endsWith('.hostingersite.com');

          if (isStaging) {
            outbound.searchParams.set('campaignId', 'su_staging_test');
            outbound.searchParams.set('sourceId', 'stripunion_staging');
            outbound.searchParams.set('p3', 'qa');
          } else {
            outbound.searchParams.set('p3', acquisition);
          }

          link.href = outbound.toString();

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'affiliate_click',
            affiliate_partner: link.getAttribute('data-affiliate-partner') || 'stripchat',
            affiliate_source: link.getAttribute('data-affiliate-source') || 'unknown',
            stripcash_campaign_id: outbound.searchParams.get('campaignId') || 'unknown',
            stripcash_creative_id: outbound.searchParams.get('creativeId') || 'unknown',
            stripcash_source_id: outbound.searchParams.get('sourceId') || 'stripunion',
            stripcash_p1: outbound.searchParams.get('p1') || 'unknown',
            stripcash_p2: outbound.searchParams.get('p2') || 'unknown',
            stripcash_p3: outbound.searchParams.get('p3') || 'unknown',
            outbound_url: link.href
          });
        });
      })();
    </script>
  </body>
</html>
