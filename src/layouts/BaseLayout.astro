---
import '../styles/global.css';
import { SITE } from '../config/site.js';

const {
  title,
  description = SITE.description,
  canonical = Astro.url.pathname,
  robots = SITE.allowIndexing ? 'index,follow' : 'noindex,nofollow',
  pageType = 'WebPage',
  image = null,
  extraSchemas = []
} = Astro.props;

const safeTitle = title || SITE.name;
const fullTitle = safeTitle.includes('StripUnion') ? safeTitle : `${safeTitle} | StripUnion`;
const canonicalUrl = new URL(canonical, SITE.url).toString();
const imageUrl = image ? new URL(image, SITE.url).toString() : null;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.svg', SITE.url).toString()
  }
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': pageType === 'Article' ? 'WebPage' : pageType,
  name: safeTitle,
  description,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url
  }
};

const schemas = [organizationSchema, pageSchema, ...extraSchemas];
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim() || '';
const validGa4MeasurementId = /^G-[A-Z0-9]{4,20}$/i.test(ga4MeasurementId);
const loadGa4 = SITE.allowIndexing && validGa4MeasurementId;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#120f18" />
    <meta name="robots" content={robots} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {loadGa4 && <>
      <link rel="preconnect" href="https://www.googletagmanager.com" />
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
      <script is:inline define:vars={{ ga4MeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', ga4MeasurementId);
      </script>
    </>}

    <meta property="og:type" content={pageType === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={SITE.locale} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}

    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="StripUnion home">StripUnion</a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href="/avcams">AVCams</a>
          <a href="/best-live-cam-sites">Best Live Cams</a>
          <a href="/stripchat-vs-chaturbate">Compare</a>
          <a href="/stripchat-pricing">Pricing & Tokens</a>
          <a href="/chaturbate-alternatives">Alternatives</a>
          <a href="/guides">Guides</a>
          <a href={SITE.blogUrl}>Blog</a>
        </nav>
        <span class="age-pill">18+</span>
        <details class="mobile-menu">
          <summary aria-label="Open navigation">Menu</summary>
          <nav aria-label="Mobile navigation">
            <a href="/avcams">AVCams</a>
            <a href="/best-live-cam-sites">Best Live Cams</a>
            <a href="/stripchat-vs-chaturbate">Stripchat vs Chaturbate</a>
            <a href="/stripchat-vs-livejasmin">Stripchat vs LiveJasmin</a>
            <a href="/stripchat-pricing">Pricing & Tokens</a>
            <a href="/chaturbate-alternatives">Chaturbate Alternatives</a>
            <a href="/guides">Guides</a>
            <a href={SITE.blogUrl}>Blog</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href="/">StripUnion</a>
          <p>Independent adult-platform reviews, comparisons and discovery guides for adults 18+.</p>
        </div>
        <div>
          <h2>Explore & compare</h2>
          <a href="/avcams">AVCams</a>
          <a href="/best-live-cam-sites">Best Live Cams</a>
          <a href="/stripchat-pricing">Pricing & Tokens</a>
          <a href="/stripchat-vs-chaturbate">Stripchat vs Chaturbate</a>
          <a href="/stripchat-vs-livejasmin">Stripchat vs LiveJasmin</a>
          <a href="/chaturbate-alternatives">Chaturbate Alternatives</a>
          <a href="/become-a-cam-model">Become a Model</a>
          <a href="/stripcash-affiliate-program">For Affiliates</a>
          <a href="/guides">Editorial Guides</a>
          <a href={SITE.blogUrl}>Blog</a>
        </div>
        <div>
          <h2>Editorial</h2>
          <a href="/about">About</a>
          <a href="/editorial-policy">Editorial Policy</a>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms">Terms of Use</a>
          <a href="/age-verification">18+ Notice</a>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} StripUnion.</span>
        <span>Adults 18+ only. Follow the laws that apply where you live.</span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const sanitize = (value) =>
          String(value || 'unknown')
            .toLowerCase()
            .replace(/[^a-z0-9_-]+/g, '_')
            .replace(/^_+|_+$/g, '')
            .slice(0, 80) || 'unknown';

        const detectAcquisition = () => {
          const params = new URLSearchParams(window.location.search);
          const utmSource = params.get('utm_source');
          if (utmSource) return sanitize(`utm_${utmSource}`);

          if (!document.referrer) return 'direct';

          try {
            const ref = new URL(document.referrer);
            const host = ref.hostname.toLowerCase();

            if (host === 'blog.stripunion.com') return 'stripunion_blog';
            if (host === window.location.hostname) return 'internal';
            if (host.includes('google.')) return 'google';
            if (host.includes('bing.')) return 'bing';
            if (host.includes('duckduckgo.')) return 'duckduckgo';
            if (host.includes('yahoo.')) return 'yahoo';
            if (host.includes('yandex.')) return 'yandex';

            return sanitize(`ref_${host}`);
          } catch {
            return 'referral';
          }
        };

        let acquisition = 'unknown';
        try {
          acquisition =
            sessionStorage.getItem('su_acquisition') ||
            detectAcquisition();
          sessionStorage.setItem('su_acquisition', acquisition);
        } catch {
          acquisition = detectAcquisition();
        }

        const createMemberId = () => {
          try {
            if (typeof crypto?.randomUUID === 'function') {
              return sanitize(`su_${crypto.randomUUID().replace(/-/g, '')}`);
            }
          } catch {}
          return sanitize(`su_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 14)}`);
        };

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('[data-affiliate-source]');
          if (!(link instanceof HTMLAnchorElement)) return;

          const outbound = new URL(link.href);
          const partner = link.getAttribute('data-affiliate-partner') || 'avcams';
          const isAvcams = partner === 'avcams';
          const isStaging = window.location.hostname === 'staging.stripunion.com' || window.location.hostname.endsWith('.hostingersite.com');
          const memberId = isAvcams ? createMemberId() : null;

          if (isAvcams) {
            outbound.searchParams.set('memberId', memberId);
            if (isStaging) {
              outbound.searchParams.set('campaignId', 'su_staging_test');
              outbound.searchParams.set('sourceId', 'stripunion_staging');
              outbound.searchParams.set('p3', 'qa');
            } else {
              outbound.searchParams.set('p3', acquisition);
            }
            link.href = outbound.toString();
          }

          const analyticsPayload = {
            affiliate_partner: partner,
            affiliate_source: link.getAttribute('data-affiliate-source') || 'unknown',
            affiliate_mode: link.getAttribute('data-affiliate-mode') || (isAvcams ? 'avcams-tracked' : 'direct'),
            acquisition_source: acquisition,
            stripcash_member_id: memberId || 'not_applicable',
            stripcash_campaign_id: isAvcams ? (outbound.searchParams.get('campaignId') || 'unknown') : 'not_applicable',
            stripcash_creative_id: isAvcams ? (outbound.searchParams.get('creativeId') || 'unknown') : 'not_applicable',
            stripcash_source_id: isAvcams ? (outbound.searchParams.get('sourceId') || 'stripunion') : 'not_applicable',
            stripcash_p1: isAvcams ? (outbound.searchParams.get('p1') || 'unknown') : 'not_applicable',
            stripcash_p2: isAvcams ? (outbound.searchParams.get('p2') || 'unknown') : 'not_applicable',
            stripcash_p3: isAvcams ? (outbound.searchParams.get('p3') || 'unknown') : 'not_applicable',
            avcams_target_domain: isAvcams ? (outbound.searchParams.get('targetDomain') || 'avcams.online') : 'not_applicable',
            avcams_path: isAvcams ? (outbound.searchParams.get('path') || 'unknown') : 'not_applicable',
            outbound_url: link.href
          };

          if (isAvcams && memberId) {
            const firstPartyClick = {
              memberId,
              occurredAt: Date.now(),
              pagePath: window.location.pathname,
              affiliateSource: analyticsPayload.affiliate_source,
              acquisitionSource: acquisition,
              campaignId: analyticsPayload.stripcash_campaign_id,
              creativeId: analyticsPayload.stripcash_creative_id,
              sourceId: analyticsPayload.stripcash_source_id,
              p1: analyticsPayload.stripcash_p1,
              p2: analyticsPayload.stripcash_p2,
              p3: analyticsPayload.stripcash_p3,
              targetDomain: analyticsPayload.avcams_target_domain,
              destinationPath: analyticsPayload.avcams_path
            };

            try {
              fetch('https://stripunion-live-models.stripunion.workers.dev/events/click', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(firstPartyClick),
                keepalive: true,
                credentials: 'omit'
              }).catch(() => {});
            } catch {}
          }

          if (typeof window.gtag === 'function') {
            window.gtag('event', 'affiliate_click', analyticsPayload);
          } else {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ event: 'affiliate_click', ...analyticsPayload });
          }
        });
      })();
    </script>
  </body>
</html>
