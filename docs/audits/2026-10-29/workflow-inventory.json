        "paths": [
          "ops/editorial/content-artifacts/*.json",
          "scripts/compile-editorial-artifacts.mjs",
          "src/data/categories.js"
        ]
      },
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "write",
      "pull-requests": "write"
    },
    "concurrency": {
      "group": "editorial-batch-compile",
      "cancel-in-progress": false
    }
  },
  {
    "file": "editorial-distribution.yml",
    "name": "Editorial distribution",
    "triggers": {
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "src/data/guides/*.js"
        ]
      }
    },
    "permissions": {
      "contents": "write"
    },
    "concurrency": null
  },
  {
    "file": "editorial-heartbeat-bridge.yml",
    "name": "Editorial heartbeat bridge",
    "triggers": {
      "push": {
        "branches": [
          "bot/stripunion-heartbeat-kicks"
        ],
        "paths": [
          "ops/control-plane/editorial-producer-kick.json"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": null
  },
  {
    "file": "editorial-hourly-producer.yml",
    "name": "Editorial hourly producer",
    "triggers": {
      "workflow_dispatch": null,
      "workflow_call": null
    },
    "permissions": {
      "contents": "write",
      "actions": "write"
    },
    "concurrency": null
  },
  {
    "file": "editorial-producer-scheduler.yml",
    "name": "Editorial producer scheduler",
    "triggers": {
      "schedule": [
        {
          "cron": "7,17,27,37,47,57 * * * *"
        }
      ],
      "workflow_dispatch": null,
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "ops/control-plane/editorial-producer-kick.json"
        ]
      },
      "workflow_run": {
        "workflows": [
          "Native social outbox",
          "Ecosystem public health",
          "Editorial production snapshot",
          "Control plane authority promotion",
          "Telegram evergreen distribution",
          "Visual QA",
          "Editorial heartbeat bridge"
        ],
        "types": [
          "completed"
        ]
      }
    },
    "permissions": {
      "contents": "write",
      "actions": "write"
    },
    "concurrency": {
      "group": "editorial-producer-scheduler-r1",
      "cancel-in-progress": false
    }
  },
  {
    "file": "editorial-production-snapshot.yml",
    "name": "Editorial production snapshot",
    "triggers": {
      "workflow_dispatch": null,
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "ops/editorial/publication-ledger/astro/*.json",
          "ops/editorial/publication-ledger/wordpress/*.json",
          "scripts/editorial-production-count.mjs",
          ".github/workflows/editorial-production-snapshot.yml"
        ]
      },
      "schedule": [
        {
          "cron": "25 * * * *"
        }
      ]
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": null
  },
  {
    "file": "growth-control-plane-sync.yml",
    "name": "Growth control plane shadow sync",
    "triggers": {
      "workflow_dispatch": {
        "inputs": {
          "required": {
            "description": "Fail if Supabase is not fully configured",
            "required": true,
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": {
      "group": "growth-control-plane-shadow-sync",
      "cancel-in-progress": false
    }
  },
