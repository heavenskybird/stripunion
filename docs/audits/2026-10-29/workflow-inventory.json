    "permissions": {
      "contents": "write",
      "actions": "write"
    },
    "concurrency": {
      "group": "seo-data-persistence",
      "cancel-in-progress": false
    }
  },
  {
    "file": "social-distribution.yml",
    "name": "Social distribution",
    "triggers": {
      "workflow_dispatch": {
        "inputs": {
          "title": {
            "description": "Published content title",
            "required": true,
            "type": "string"
          },
          "url": {
            "description": "Published content URL",
            "required": true,
            "type": "string"
          },
          "excerpt": {
            "description": "Short excerpt or summary",
            "required": false,
            "type": "string"
          },
          "post_id": {
            "description": "Source post ID",
            "required": false,
            "type": "string"
          },
          "source": {
            "description": "Event source",
            "required": false,
            "default": "wordpress",
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": null
  },
  {
    "file": "social-outbox-heartbeat.yml",
    "name": "Social outbox heartbeat",
    "triggers": {
      "workflow_dispatch": null,
      "workflow_run": {
        "workflows": [
          "Editorial heartbeat bridge",
          "Ecosystem public health",
          "Editorial production snapshot"
        ],
        "types": [
          "completed"
        ]
      }
    },
    "permissions": {
      "contents": "write",
      "actions": "write"
    },
    "concurrency": {
      "group": "native-social-outbox",
      "cancel-in-progress": false
    }
  },
  {
    "file": "social-outbox.yml",
