  {
    "file": "seo-data-daily.yml",
    "name": "SEO data daily",
    "triggers": {
      "workflow_dispatch": null,
      "push": {
        "paths": [
          ".github/workflows/seo-data-daily.yml",
          "ops/seo-data-layer/src/collectors/**",
