[
  {
    "file": "build.yml",
    "name": "Build",
    "triggers": {
      "push": {
        "branches": [
          "**"
        ],
        "paths-ignore": [
          "ops/editorial/publication-ledger/**",
          "ops/editorial/hourly-backlog.json",
          "ops/social-outbox/events/**",
          "ops/control-plane/editorial-producer-kick.json",
          "ops/control-plane/social-outbox-kick.json",
          "ops/control-plane/editorial-r1-receipt.json"
        ]
      },
      "pull_request": {
        "branches": [
          "main"
        ]
      }
    },
    "permissions": null,
    "concurrency": null
  },
  {
    "file": "control-plane-authority-promotion.yml",
    "name": "Control plane authority promotion",
    "triggers": {
      "schedule": [
        {
          "cron": "47 * * * *"
        }
      ],
      "workflow_dispatch": null
    },
    "permissions": {
      "contents": "write"
    },
    "concurrency": {
      "group": "control-plane-authority-promotion",
      "cancel-in-progress": false
    }
  },
  {
    "file": "deploy-live-models-worker.yml",
    "name": "Deploy live models worker",
    "triggers": {
      "workflow_dispatch": null,
      "push": {
        "branches": [
          "main"
        ],
        "paths": [
          "services/live-models-worker/**",
          ".github/workflows/deploy-live-models-worker.yml"
        ]
      }
    },
    "permissions": {
      "contents": "read"
    },
    "concurrency": null
  },
  {
    "file": "editorial-backfill-2026-10-04.yml",
