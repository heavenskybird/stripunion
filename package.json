    "compile:editorial-artifacts": "node scripts/compile-editorial-artifacts.mjs",
    "report:editorial-production": "node scripts/editorial-production-count.mjs 24",
    "test:visual": "node scripts/visual-regression.mjs",
    "reconcile:editorial-backlog": "node scripts/reconcile-editorial-backlog.mjs",
